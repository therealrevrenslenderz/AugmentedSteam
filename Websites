<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mental MutilationZ Designer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        blood: '#8B0000',
                        darkBlood: '#4A0000',
                        bone: '#E3DAC9',
                        midnight: '#0a0a0a',
                        crimson: '#DC143C',
                        acid: '#39FF14'
                    },
                    animation: {
                        'pulse-fast': 'pulse 1s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                        'flicker': 'flicker 3s linear infinite',
                        'drip': 'drip 4s ease-in-out infinite',
                        'float': 'float 6s ease-in-out infinite',
                        'glitch': 'glitch 1s linear infinite',
                        'distort': 'distort 5s ease-in-out infinite',
                        'shake': 'shake 0.5s cubic-bezier(.36,.07,.19,.97) infinite'
                    },
                    keyframes: {
                        flicker: {
                            '0%, 100%': { opacity: 1 },
                            '50%': { opacity: 0.3 }
                        },
                        drip: {
                            '0%': { transform: 'translateY(0)' },
                            '70%': { transform: 'translateY(100%)', opacity: 1 },
                            '100%': { transform: 'translateY(150%)', opacity: 0 }
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-20px)' }
                        },
                        glitch: {
                            '0%, 100%': { transform: 'translate(0)' },
                            '20%': { transform: 'translate(-5px, 5px)' },
                            '40%': { transform: 'translate(-5px, -5px)' },
                            '60%': { transform: 'translate(5px, 5px)' },
                            '80%': { transform: 'translate(5px, -5px)' }
                        },
                        distort: {
                            '0%': { filter: 'blur(0) hue-rotate(0deg)' },
                            '25%': { filter: 'blur(2px) hue-rotate(90deg)' },
                            '50%': { filter: 'blur(0) hue-rotate(180deg)' },
                            '75%': { filter: 'blur(3px) hue-rotate(270deg)' },
                            '100%': { filter: 'blur(0) hue-rotate(360deg)' }
                        },
                        shake: {
                            '0%, 100%': { transform: 'translateX(0)' },
                            '10%, 30%, 50%, 70%, 90%': { transform: 'translateX(-5px)' },
                            '20%, 40%, 60%, 80%': { transform: 'translateX(5px)' }
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Creepster&family=Special+Elite&display=swap');

        /* Custom CSS Effects */
        .font-creepster {
            font-family: 'Creepster', cursive;
        }
        
        .font-elite {
            font-family: 'Special Elite', cursive;
        }
        
        .text-shadow-red {
            text-shadow: 0 0 8px #ff0000, 0 0 12px #ff0000;
        }
        
        .text-shadow-blood {
            text-shadow: 0 0 10px #8B0000, 0 0 15px #8B0000, 0 0 20px #8B0000;
        }
        
        .text-glitch {
            position: relative;
        }
        
        .text-glitch::before,
        .text-glitch::after {
            content: attr(data-text);
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        
        .text-glitch::before {
            left: 2px;
            text-shadow: -2px 0 #ff00ff;
            animation: glitch-anim-1 2s infinite linear alternate-reverse;
        }
        
        .text-glitch::after {
            left: -2px;
            text-shadow: 2px 0 #00ffff;
            animation: glitch-anim-2 3s infinite linear alternate-reverse;
        }
        
        @keyframes glitch-anim-1 {
            0%, 100% { clip-path: inset(50% 0 30% 0); }
            20% { clip-path: inset(33% 0 33% 0); }
            40% { clip-path: inset(10% 0 60% 0); }
            60% { clip-path: inset(62% 0 2% 0); }
            80% { clip-path: inset(43% 0 27% 0); }
        }
        
        @keyframes glitch-anim-2 {
            0%, 100% { clip-path: inset(25% 0 58% 0); }
            20% { clip-path: inset(73% 0 5% 0); }
            40% { clip-path: inset(35% 0 56% 0); }
            60% { clip-path: inset(7% 0 92% 0); }
            80% { clip-path: inset(94% 0 3% 0); }
        }
        
        .scanline {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            pointer-events: none;
        }
        
        .scanline::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 2px;
            background: rgba(255, 255, 255, 0.3);
            opacity: 0.75;
            animation: scanline 6s linear infinite;
        }
        
        @keyframes scanline {
            0% {
                top: 0%;
            }
            100% {
                top: 100%;
            }
        }
        
        .blood-drip {
            position: absolute;
            width: 4px;
            height: 20px;
            background: linear-gradient(to bottom, #8B0000 60%, rgba(139, 0, 0, 0));
            border-radius: 0 0 2px 2px;
            animation: drip 3s infinite;
            opacity: 0.8;
        }
        
        .blood-drip:nth-child(2n) {
            animation-delay: 0.5s;
            height: 25px;
        }
        
        .blood-drip:nth-child(3n) {
            animation-delay: 1.2s;
            height: 16px;
        }
        
        .blood-drip:nth-child(4n) {
            animation-delay: 2.7s;
            height: 30px;
        }
        
        .noise {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0.08;
            z-index: 100;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
        }
        
        .tv-effect {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.25) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 10;
        }
        
        .vignette {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            box-shadow: inset 0 0 100px rgba(0,0,0,0.8);
            pointer-events: none;
            z-index: 15;
        }

        /* Blood puddle effect */
        .blood-puddle {
            position: absolute;
            background: radial-gradient(ellipse at center, #8B0000 0%, rgba(139, 0, 0, 0.8) 40%, rgba(139, 0, 0, 0) 70%);
            border-radius: 50%;
            opacity: 0.8;
        }

        .category-card {
            transition: all 0.3s ease;
            transform-style: preserve-3d;
            perspective: 1000px;
        }
        
        .category-card:hover {
            transform: scale(1.03) translateZ(10px);
            box-shadow: 0 0 20px rgba(220, 20, 60, 0.6);
        }
        
        .glitch-img {
            position: relative;
            overflow: hidden;
        }
        
        .glitch-img::before {
            content: '';
            position: absolute;
            top: 0;
            left: -10px;
            width: calc(100% + 20px);
            height: 100%;
            background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.2) 45%, transparent 55%);
            transform: skewX(-30deg);
            animation: glitch-scan 3s linear infinite;
        }

        @keyframes glitch-scan {
            0% { left: -100%; }
            100% { left: 100%; }
        }
    </style>
</head>
<body class="bg-midnight text-white h-screen w-screen overflow-hidden relative">
    <!-- Noise and TV effect overlays -->
    <div class="noise"></div>
    <div class="tv-effect"></div>
    <div class="scanline"></div>
    <div class="vignette"></div>
    
    <!-- Warning Screen -->
    <div id="warning-screen" class="fixed inset-0 flex flex-col items-center justify-center z-50 px-6 text-center">
        <div class="relative mb-8 animate-float">
            <div class="absolute -top-8 left-1/2 transform -translate-x-1/2 w-full">
                <div class="blood-drip absolute" style="left: 10%;"></div>
                <div class="blood-drip absolute" style="left: 20%;"></div>
                <div class="blood-drip absolute" style="left: 35%;"></div>
                <div class="blood-drip absolute" style="left: 50%;"></div>
                <div class="blood-drip absolute" style="left: 65%;"></div>
                <div class="blood-drip absolute" style="left: 85%;"></div>
                <div class="blood-drip absolute" style="left: 95%;"></div>
            </div>
            <svg width="120" height="120" viewBox="0 0 120 120">
                <polygon points="60,10 10,110 110,110" fill="none" stroke="#DC143C" stroke-width="4" class="animate-pulse-fast" />
                <text x="52" y="80" fill="#DC143C" font-size="60" class="font-bold animate-pulse-fast">!</text>
            </svg>
        </div>
        
        <h1 class="text-4xl md:text-6xl font-creepster text-crimson text-shadow-blood mb-4 animate-glitch" data-text="WARNING">WARNING</h1>
        
        <div class="bg-black/50 border border-blood p-6 max-w-xl relative backdrop-blur">
            <!-- Blood splatters -->
            <div class="blood-puddle" style="width: 100px; height: 60px; top: -20px; right: -20px; transform: rotate(20deg);"></div>
            <div class="blood-puddle" style="width: 120px; height: 70px; bottom: -30px; left: -40px; transform: rotate(-10deg);"></div>
            
            <div class="animate-distort text-2xl sm:text-3xl font-creepster text-acid mb-6 tracking-wider">
                ©️2025MentalMutilationZ
            </div>
            
            <p class="font-elite text-lg sm:text-xl mb-8 text-bone">
                <span class="text-crimson font-bold">NOT</span> for the faint hearted or closedminded 
                <br><span class="text-blood animate-pulse-fast">ENTER AT YOUR OWN RISK</span>
            </p>
            
            <button id="enter-btn" class="relative overflow-hidden bg-blood hover:bg-darkBlood text-white font-bold py-3 px-8 rounded-sm transition-all duration-300 transform hover:scale-105 group">
                <span class="relative z-10 font-elite tracking-wider text-lg">ENTER IF YOU DARE</span>
                <span class="absolute inset-0 bg-crimson/20 animate-pulse-fast"></span>
            </button>
        </div>
    </div>
    
    <!-- Category Selection Screen (initially hidden) -->
    <div id="category-screen" class="fixed inset-0 flex flex-col justify-center items-center p-6 opacity-0 pointer-events-none transition-opacity duration-500">
        <div class="relative w-full max-w-5xl">
            <!-- Blood drips from top -->
            <div class="absolute -top-6 left-0 right-0">
                <div class="blood-drip absolute" style="left: 5%;"></div>
                <div class="blood-drip absolute" style="left: 15%;"></div>
                <div class="blood-drip absolute" style="left: 25%;"></div>
                <div class="blood-drip absolute" style="left: 40%;"></div>
                <div class="blood-drip absolute" style="left: 55%;"></div>
                <div class="blood-drip absolute" style="left: 70%;"></div>
                <div class="blood-drip absolute" style="left: 85%;"></div>
                <div class="blood-drip absolute" style="left: 95%;"></div>
            </div>
            
            <h2 class="text-3xl sm:text-5xl md:text-6xl font-creepster text-blood text-shadow-red mb-8 text-center animate-shake">
                CHOOSE YOUR NIGHTMARE
            </h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- MentalMutilationZ Category -->
                <div class="category-card bg-gradient-to-br from-black to-darkBlood border-2 border-blood rounded-lg overflow-hidden hover:border-crimson">
                    <div class="glitch-img h-40 bg-black relative overflow-hidden">
                        <!-- Abstract disturbing artwork created with SVG -->
                        <svg width="100%" height="100%" viewBox="0 0 400 200">
                            <defs>
                                <filter id="distortion1" x="0" y="0" width="100%" height="100%">
                                    <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="1" />
                                    <feDisplacementMap in="SourceGraphic" scale="30" />
                                </filter>
                                <linearGradient id="bloodGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#8B0000" />
                                    <stop offset="50%" stop-color="#DC143C" />
                                    <stop offset="100%" stop-color="#4A0000" />
                                </linearGradient>
                            </defs>
                            
                            <rect x="0" y="0" width="400" height="200" fill="black" />
                            
                            <!-- Abstract blood splatters -->
                            <circle cx="100" cy="100" r="70" fill="url(#bloodGradient)" filter="url(#distortion1)" opacity="0.8" />
                            <circle cx="250" cy="80" r="50" fill="#8B0000" filter="url(#distortion1)" opacity="0.7" />
                            
                            <!-- Pulsing elements -->
                            <circle cx="200" cy="100" r="20" fill="#DC143C" opacity="0.9">
                                <animate attributeName="r" values="20;30;20" dur="2s" repeatCount="indefinite" />
                            </circle>
                            
                            <!-- Abstract shapes -->
                            <path d="M50,150 Q100,50 150,150 T250,150 T350,150" stroke="#8B0000" stroke-width="5" fill="none" />
                            <path d="M100,50 Q200,150 300,50" stroke="#DC143C" stroke-width="3" fill="none" />
                        </svg>
                        
                        <!-- Overlay text -->
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-glitch text-white font-creepster text-2xl sm:text-3xl" data-text="MENTAL MUTILATION">
                                MENTAL MUTILATION
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-5 relative">
                        <h3 class="text-2xl font-creepster text-crimson mb-3 tracking-wider">
                            #MentalMutilationZ & GruesomeHallucinationZ
                        </h3>
                        <p class="font-elite text-sm text-bone opacity-80">
                            Descend into the twisted depths of consciousness. Experience grotesque transformations of reality.
                        </p>
                        <div class="mt-4 flex justify-end">
                            <button class="bg-blood px-4 py-2 text-white font-elite hover:bg-crimson transition-colors duration-300 relative overflow-hidden group">
                                ENTER
                                <span class="absolute inset-0 bg-white opacity-10 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
                            </button>
                        </div>
                    </div>
                </div>
                
                <!-- RevreN SlenderZ Category -->
                <div class="category-card bg-gradient-to-br from-black to-darkBlood border-2 border-blood rounded-lg overflow-hidden hover:border-crimson">
                    <div class="glitch-img h-40 bg-black relative overflow-hidden">
                        <!-- Abstract disturbing artwork created with SVG -->
                        <svg width="100%" height="100%" viewBox="0 0 400 200">
                            <defs>
                                <filter id="distortion2" x="0" y="0" width="100%" height="100%">
                                    <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="2" />
                                    <feDisplacementMap in="SourceGraphic" scale="20" />
                                </filter>
                                <radialGradient id="fogGradient" cx="50%" cy="50%" r="70%" fx="50%" fy="50%">
                                    <stop offset="0%" stop-color="#222" />
                                    <stop offset="70%" stop-color="#111" />
                                    <stop offset="100%" stop-color="black" />
                                </radialGradient>
                            </defs>
                            
                            <rect x="0" y="0" width="400" height="200" fill="black" />
                            <rect x="0" y="0" width="400" height="200" fill="url(#fogGradient)" />
                            
                            <!-- Tall slender figure in the background -->
                            <g opacity="0.8" filter="url(#distortion2)">
                                <line x1="200" y1="40" x2="200" y2="160" stroke="#333" stroke-width="3" />
                                <circle cx="200" cy="30" r="10" fill="#222" />
                                <line x1="200" y1="70" x2="180" y2="100" stroke="#333" stroke-width="2" />
                                <line x1="200" y1="70" x2="220" y2="100" stroke="#333" stroke-width="2" />
                                <line x1="200" y1="160" x2="190" y2="190" stroke="#333" stroke-width="2" />
                                <line x1="200" y1="160" x2="210" y2="190" stroke="#333" stroke-width="2" />
                            </g>
                            
                            <!-- Flickering elements -->
                            <circle cx="130" cy="40" r="2" fill="white">
                                <animate attributeName="opacity" values="0.2;0.8;0.2" dur="3s" repeatCount="indefinite" />
                            </circle>
                            <circle cx="260" cy="70" r="3" fill="white">
                                <animate attributeName="opacity" values="0.1;0.6;0.1" dur="4s" repeatCount="indefinite" />
                            </circle>
                            <circle cx="100" cy="150" r="1" fill="white">
                                <animate attributeName="opacity" values="0.2;0.5;0.2" dur="2s" repeatCount="indefinite" />
                            </circle>
                            
                            <!-- Blood elements -->
                            <path d="M150,170 Q200,190 250,170" stroke="#8B0000" stroke-width="2" fill="none" />
                        </svg>
                        
                        <!-- Overlay text -->
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="text-glitch text-white font-creepster text-2xl sm:text-3xl" data-text="REVREN SLENDERZ">
                                REVREN SLENDERZ
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-5 relative">
                        <h3 class="text-2xl font-creepster text-crimson mb-3 tracking-wider">
                            #RevreN SlenderZ
                        </h3>
                        <p class="font-elite text-sm text-bone opacity-80">
                            Encounter the haunting presence that lurks in the shadows. Feel the dread of being watched from afar.
                        </p>
                        <div class="mt-4 flex justify-end">
                            <button class="bg-blood px-4 py-2 text-white font-elite hover:bg-crimson transition-colors duration-300 relative overflow-hidden group">
                                ENTER
                                <span class="absolute inset-0 bg-white opacity-10 transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-300"></span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script>
        // Initialize dark mode
        document.documentElement.classList.add('dark');
        
        // Handle entering the app
        const enterBtn = document.getElementById('enter-btn');
        const warningScreen = document.getElementById('warning-screen');
        const categoryScreen = document.getElementById('category-screen');
        
        // Create blood effect elements
        function createBloodEffects() {
            // Create random blood puddles
            for (let i = 0; i < 8; i++) {
                const puddle = document.createElement('div');
                puddle.classList.add('blood-puddle');
                puddle.style.width = `${30 + Math.random() * 100}px`;
                puddle.style.height = `${20 + Math.random() * 60}px`;
                puddle.style.left = `${Math.random() * 90}%`;
                puddle.style.top = `${Math.random() * 90}%`;
                puddle.style.transform = `rotate(${Math.random() * 360}deg)`;
                puddle.style.opacity = `${0.2 + Math.random() * 0.4}`;
                document.body.appendChild(puddle);
            }
        }
        
        // Add disturbing audio effects when entering
        function playDisturbingSound() {
            // Using AudioContext to create a disturbing sound effect
            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            
            // Create oscillator for eerie noise
            const oscillator = audioCtx.createOscillator();
            oscillator.type = 'sawtooth';
            oscillator.frequency.setValueAtTime(120, audioCtx.currentTime);
            
            // Create gain node for volume control
            const gainNode = audioCtx.createGain();
            gainNode.gain.setValueAtTime(0.1, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 1.5);
            
            // Connect nodes
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);
            
            // Start and stop the sound
            oscillator.start();
            setTimeout(() => {
                oscillator.stop();
            }, 1500);
        }
        
        // Add glitch effect to screen transition
        function addScreenGlitch() {
            const glitchOverlay = document.createElement('div');
            glitchOverlay.classList.add('fixed', 'inset-0', 'bg-black', 'z-40', 'pointer-events-none');
            glitchOverlay.style.opacity = '0';
            document.body.appendChild(glitchOverlay);
            
            // Flash effect
            setTimeout(() => {
                glitchOverlay.style.opacity = '0.8';
                setTimeout(() => {
                    glitchOverlay.style.opacity = '0';
                    setTimeout(() => {
                        glitchOverlay.style.opacity = '0.5';
                        setTimeout(() => {
                            glitchOverlay.style.opacity = '0';
                            document.body.removeChild(glitchOverlay);
                        }, 100);
                    }, 100);
                }, 100);
            }, 100);
        }
        
        // Event listeners
        enterBtn.addEventListener('click', () => {
            // Play disturbing sound
            playDisturbingSound();
            
            // Add screen glitch effect
            addScreenGlitch();
            
            // Transition to category screen
            warningScreen.classList.add('opacity-0');
            setTimeout(() => {
                warningScreen.classList.add('pointer-events-none');
                categoryScreen.classList.remove('opacity-0', 'pointer-events-none');
                createBloodEffects();
            }, 500);
        });
        
        // Simulate TV flicker effect randomly
        setInterval(() => {
            if (Math.random() > 0.7) {
                addScreenGlitch();
            }
        }, 8000);
        
        // Add random "glitch" to elements
        function addRandomGlitches() {
            const elements = document.querySelectorAll('h1, h2, h3');
            const randomElement = elements[Math.floor(Math.random() * elements.length)];
            
            randomElement.classList.add('animate-glitch');
            setTimeout(() => {
                randomElement.classList.remove('animate-glitch');
            }, 500);
        }
        
        setInterval(addRandomGlitches, 5000);
    </script>
</body>
</html>
